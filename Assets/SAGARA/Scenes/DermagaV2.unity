  coralRecords:
  - id: branching_coral_observation
    displayName: Karang Tanduk
    description: Terumbu bercabang berwarna koral kemerahan yang menjadi rumah berlindung
      bagi ikan-ikan karang kecil di perairan dangkal.
    accent: {r: 0.92, g: 0.42, b: 0.36, a: 1}
    portrait: {fileID: 2800000, guid: 5c2ef02f94625994b81c448871922557, type: 3}
  - id: plate_coral_observation
    displayName: Karang Meja
    description: Koloni karang berbentuk piringan bertingkat bertepi keemasan yang
      menangkap cahaya matahari untuk mikroalga simbionnya.
    accent: {r: 0.22, g: 0.68, b: 0.62, a: 1}
    portrait: {fileID: 2800000, guid: c4044875c8e2fd54c816a8510cc80c16, type: 3}
  - id: massive_coral_observation
    displayName: Karang Otak
    description: Karang kubah masif bertekstur alur alami yang tumbuh perlahan namun
      sangat tangguh menahan terjangan ombak pesisir.
    accent: {r: 0.86, g: 0.68, b: 0.28, a: 1}
    portrait: {fileID: 2800000, guid: c1439a6f6b7ccf94ea13f147c9124504, type: 3}
  - id: seafan_coral_observation
    displayName: Kipas Laut Sagara
    description: Karang kipas gorgonia dengan jalinan ranting lentur berwarna ungu-koral
      yang melambai mengikuti arus laut jernih.
    accent: {r: 0.76, g: 0.34, b: 0.64, a: 1}
    portrait: {fileID: 2800000, guid: e99da066c3da0b84ebd9261d9b8b2f45, type: 3}
  - id: anemone_coral_observation
    displayName: Anemon Terumbu
    description: Anemon laut berumbai lembut dengan ujung berpendar kehijauan yang
      menjalin simbiosis hangat bersama ikan badut pesisir.
    accent: {r: 0.94, g: 0.54, b: 0.42, a: 1}
    portrait: {fileID: 2800000, guid: c5165b64a03cb164ca602222280b27b6, type: 3}
