  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  displayName: Pak Darma
  role: Nelayan
  talkDistance: 2.2
  turnSpeed: 360
  portraits:
  - {fileID: 2800000, guid: d95f6dd21b8a8574ebe228053d4dab51, type: 3}
  - {fileID: 2800000, guid: 7e823d71038b819438f203eed167c8f4, type: 3}
  - {fileID: 2800000, guid: 3fda0f5139cb774479d8b6502860a1a6, type: 3}
  - {fileID: 2800000, guid: 80e52718cd8018947a2bcca743b371c1, type: 3}
  - {fileID: 2800000, guid: 74e0612239fccb649b0954dab6036936, type: 3}
  firstLines:
  - expression: 0
    text: Silakan mancing kapan saja, Nak. Kalau kamu ingin membantu lagi, ada terumbu
      karang yang perlu kita rawat di lepas pantai.
  - expression: 2
    text: Kita bisa pasang fragmen dari pembibitan. Siapkan tali dekat rumah Bapak,
      rangka di depan gudang, dan pelampung jingga di dermaga.
  - expression: 1
    text: Kalau semuanya sudah lengkap, temui Bapak sebelum naik perahu.
  repeatLines: []
  choicePrompt:
    expression: 0
    text: Ada yang ingin kamu tanyakan?
  topics: []
  farewellOption: Tidak ada, terima kasih.
  farewellLines: []
