  m_Script: {fileID: 11500000, guid: ee948ad752ec36243bac452191fb49dc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  displayName: Pak Darma
  role: Nelayan
  talkDistance: 2.2
  turnSpeed: 360
  portraits:
  - {fileID: 2800000, guid: d95f6dd21b8a8574ebe228053d4dab51, type: 3}
  - {fileID: 2800000, guid: 7e823d71038b819438f203eed167c8f4, type: 3}
  - {fileID: 2800000, guid: 3fda0f5139cb774479d8b6502860a1a6, type: 3}
  - {fileID: 2800000, guid: 80e52718cd8018947a2bcca743b371c1, type: 3}
  - {fileID: 2800000, guid: 74e0612239fccb649b0954dab6036936, type: 3}
  firstLines:
  - expression: 1
    text: Terima kasih sudah menanam empat bibit itu. Sekarang kita beri waktu supaya
      mangrovenya tumbuh.
  - expression: 2
    text: Sekarang Bapak mau memeriksa terumbu di lepas pantai. Kita bisa membawa
      fragmen dari pembibitan untuk membantu karang pulih.
  - expression: 3
    text: Tolong ambil tali di dekat rumah Bapak, rangka di depan gudang, dan pelampung
      jingga di dermaga. Setelah lengkap, temui Bapak lagi, ya.
  repeatLines: []
  choicePrompt:
    expression: 0
    text: Ada yang ingin kamu tanyakan?
  topics: []
  farewellOption: Tidak ada, terima kasih.
  farewellLines: []
